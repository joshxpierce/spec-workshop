@@ -21,13 +21,28 @@ export function validateMessage(body, store) {
   return errors;
 }
 
-// Evaluates a validated message. Returns { verdict, reason, senderDomain }.
+// Evaluates a validated message. Returns { verdict, reason, senderDomain },
+// plus overriddenReason when the allowlist skipped a QUARANTINE rule.
+//
+// Order: BLOCK rules, then QUARANTINE rules, then CLEAN.
+// An allowlisted sender domain skips QUARANTINE rules only, and only when
+// SPF passed. The From domain alone is trivially spoofed, so without an SPF
+// pass the allowlist does nothing. The allowlist never overrides BLOCK rules.
 export function evaluate(message, store) {
   const sender = parseSender(message.sender);
   const context = { store, sender };
-  for (const rule of [...blockRules, ...quarantineRules]) {
+  const senderDomain = sender.domain;
+  for (const rule of blockRules) {
     const result = rule.evaluate(message, context);
-    if (result) return { ...result, senderDomain: sender.domain };
+    if (result) return { ...result, senderDomain };
   }
-  return { verdict: Verdict.ALLOW, reason: Reason.CLEAN, senderDomain: sender.domain };
+  for (const rule of quarantineRules) {
+    const result = rule.evaluate(message, context);
+    if (!result) continue;
+    if (message.spf === 'pass' && store.isAllowlisted(message.tenantId, senderDomain)) {
+      return { verdict: Verdict.ALLOW, reason: Reason.ALLOWLIST, senderDomain, overriddenReason: result.reason };
+    }
+    return { ...result, senderDomain };
+  }
+  return { verdict: Verdict.ALLOW, reason: Reason.CLEAN, senderDomain };
 }
diff --git a/tests/allowlist.test.js b/tests/allowlist.test.js
new file mode 100644
index 0000000..4239fcf
--- /dev/null
+++ b/tests/allowlist.test.js
@@ -0,0 +1,115 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore } from '../src/store.js';
+import { evaluate } from '../src/verdict.js';
+import { REASON_LABELS } from '../src/reporting/daily-summary.js';
+import { startTestServer } from './helpers.js';
+
+const ADMIN = 'tok-acme-admin';
+const pick = ({ verdict, reason }) => ({ verdict, reason });
+const zip = [{ filename: 'invoice.zip' }];
+const vendorMsg = (overrides) => ({
+  tenantId: 'acme',
+  sender: '"Vendor Billing" <billing@VendorCorp.com>',
+  spf: 'pass',
+  attachments: zip,
+  ...overrides,
+});
+const storeWith = (allowlist, blocklist = {}) => createStore({ allowlist, blocklist });
+
+test('allowlisted sender with SPF pass skips QUARANTINE rules', () => {
+  const store = storeWith({ acme: ['vendorcorp.com'] });
+  const result = evaluate(vendorMsg(), store);
+  assert.deepEqual(pick(result), { verdict: 'ALLOW', reason: 'ALLOWLIST' });
+  assert.equal(result.overriddenReason, 'ATTACHMENT_TYPE');
+});
+
+test('allowlist does nothing without an SPF pass', () => {
+  const store = storeWith({ acme: ['vendorcorp.com'] });
+  for (const spf of [undefined, 'none', 'softfail']) {
+    assert.deepEqual(pick(evaluate(vendorMsg({ spf }), store)), { verdict: 'QUARANTINE', reason: 'ATTACHMENT_TYPE' }, `spf=${spf}`);
+  }
+});
+
+test('allowlist never overrides BLOCK rules', () => {
+  const store = storeWith({ acme: ['vendorcorp.com'] }, { acme: ['vendorcorp.com'] });
+  assert.deepEqual(pick(evaluate(vendorMsg(), store)), { verdict: 'BLOCK', reason: 'BLOCKLIST' });
+  const spfStore = storeWith({ acme: ['vendorcorp.com'] });
+  assert.deepEqual(pick(evaluate(vendorMsg({ spf: 'fail' }), spfStore)), { verdict: 'BLOCK', reason: 'SPF_FAIL' });
+});
+
+test('allowlisted sender with no rule match is still CLEAN', () => {
+  const store = storeWith({ acme: ['vendorcorp.com'] });
+  const result = evaluate(vendorMsg({ attachments: [] }), store);
+  assert.deepEqual(pick(result), { verdict: 'ALLOW', reason: 'CLEAN' });
+  assert.equal(result.overriddenReason, undefined);
+});
+
+test('allowlist matches the exact domain only', () => {
+  const store = storeWith({ acme: ['vendorcorp.com'] });
+  for (const sender of ['x@mail.vendorcorp.com', 'x@vendorcorp.com.evil.example', 'x@notvendorcorp.com']) {
+    assert.equal(evaluate(vendorMsg({ sender }), store).verdict, 'QUARANTINE', sender);
+  }
+});
+
+test('allowlist is tenant-scoped', () => {
+  const store = storeWith({ acme: ['vendorcorp.com'] });
+  assert.equal(evaluate(vendorMsg({ tenantId: 'globex' }), store).verdict, 'QUARANTINE');
+});
+
+test('ALLOWLIST has a reporting label', () => {
+  assert.equal(REASON_LABELS.ALLOWLIST, 'Delivered: sender allowlist');
+});
+
+test('allowlist API: add, list, use, remove, with one audit row per change', async () => {
+  const app = await startTestServer();
+  try {
+    const add = await app.request('POST', '/tenants/acme/allowlist', { token: ADMIN, body: { domain: 'VendorCorp.COM' } });
+    assert.equal(add.status, 201);
+    assert.deepEqual(add.body, { domain: 'vendorcorp.com' });
+    const dup = await app.request('POST', '/tenants/acme/allowlist', { token: ADMIN, body: { domain: 'vendorcorp.com' } });
+    assert.equal(dup.status, 409);
+    const bad = await app.request('POST', '/tenants/acme/allowlist', { token: ADMIN, body: { domain: '*.vendorcorp.com' } });
+    assert.equal(bad.status, 400);
+
+    const list = await app.request('GET', '/tenants/acme/allowlist', { token: ADMIN });
+    assert.deepEqual(list.body, { domains: ['vendorcorp.com'] });
+
+    const verdict = await app.request('POST', '/verdict', { body: vendorMsg({ subject: 'Invoice 4471' }) });
+    assert.deepEqual(verdict.body, { verdict: 'ALLOW', reason: 'ALLOWLIST' });
+    const line = app.logs.find((l) => l.event === 'verdict');
+    assert.equal(line.overriddenReason, 'ATTACHMENT_TYPE');
+    assert.equal(line.senderDomain, 'vendorcorp.com');
+    const logged = JSON.stringify(app.logs);
+    assert.ok(!logged.includes('Invoice 4471') && !logged.includes('billing@') && !logged.includes('invoice.zip'));
+
+    const del = await app.request('DELETE', '/tenants/acme/allowlist/vendorcorp.com', { token: ADMIN });
+    assert.equal(del.status, 204);
+    const gone = await app.request('DELETE', '/tenants/acme/allowlist/vendorcorp.com', { token: ADMIN });
+    assert.equal(gone.status, 404);
+
+    const audit = await app.request('GET', '/tenants/acme/audit', { token: ADMIN });
+    assert.deepEqual(
+      audit.body.entries.map((r) => [r.action, r.actor, r.domain]),
+      [
+        ['allowlist.add', 'alice@acme.example', 'vendorcorp.com'],
+        ['allowlist.remove', 'alice@acme.example', 'vendorcorp.com'],
+      ],
+    );
+  } finally {
+    await app.close();
+  }
+});
+
+test('allowlist API requires a tenant admin', async () => {
+  const app = await startTestServer();
+  try {
+    const body = { domain: 'vendorcorp.com' };
+    assert.equal((await app.request('POST', '/tenants/acme/allowlist', { body })).status, 401);
+    assert.equal((await app.request('POST', '/tenants/acme/allowlist', { token: 'tok-acme-viewer', body })).status, 403);
+    assert.equal((await app.request('POST', '/tenants/acme/allowlist', { token: 'tok-globex-admin', body })).status, 403);
+    assert.equal((await app.request('GET', '/tenants/acme/allowlist', { token: 'tok-globex-admin' })).status, 403);
+  } finally {
+    await app.close();
+  }
+});
