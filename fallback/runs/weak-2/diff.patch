diff --git a/tests/api.test.js b/tests/api.test.js
index 79523a4..ac87171 100644
--- a/tests/api.test.js
+++ b/tests/api.test.js
@@ -92,3 +92,61 @@ test('blocklist add and remove each write one audit row', async () => {
     await app.close();
   }
 });
+
+test('allowlist add and remove each write one audit row and change the verdict', async () => {
+  const app = await startTestServer();
+  const vendorMail = {
+    tenantId: 'acme',
+    sender: 'billing@vendorcorp.example',
+    spf: 'pass',
+    attachments: [{ filename: 'invoice.zip' }],
+  };
+  try {
+    let v = await app.request('POST', '/verdict', { body: vendorMail });
+    assert.deepEqual(v.body, { verdict: 'QUARANTINE', reason: 'ATTACHMENT_TYPE' });
+
+    const add = await app.request('POST', '/tenants/acme/allowlist', { token: ADMIN, body: { domain: 'VendorCorp.Example' } });
+    assert.equal(add.status, 201);
+    assert.deepEqual(add.body, { domain: 'vendorcorp.example' });
+    const dup = await app.request('POST', '/tenants/acme/allowlist', { token: ADMIN, body: { domain: 'vendorcorp.example' } });
+    assert.equal(dup.status, 409);
+    const bad = await app.request('POST', '/tenants/acme/allowlist', { token: ADMIN, body: { domain: '*.vendorcorp.example' } });
+    assert.equal(bad.status, 400);
+    const list = await app.request('GET', '/tenants/acme/allowlist', { token: ADMIN });
+    assert.deepEqual(list.body, { domains: ['vendorcorp.example'] });
+
+    v = await app.request('POST', '/verdict', { body: vendorMail });
+    assert.deepEqual(v.body, { verdict: 'ALLOW', reason: 'ALLOWLIST' });
+
+    const del = await app.request('DELETE', '/tenants/acme/allowlist/vendorcorp.example', { token: ADMIN });
+    assert.equal(del.status, 204);
+    const missing = await app.request('DELETE', '/tenants/acme/allowlist/vendorcorp.example', { token: ADMIN });
+    assert.equal(missing.status, 404);
+
+    const audit = await app.request('GET', '/tenants/acme/audit', { token: ADMIN });
+    const rows = audit.body.entries.filter((r) => r.domain === 'vendorcorp.example');
+    assert.deepEqual(
+      rows.map((r) => [r.action, r.actor, r.tenantId]),
+      [
+        ['allowlist.add', 'alice@acme.example', 'acme'],
+        ['allowlist.remove', 'alice@acme.example', 'acme'],
+      ],
+    );
+  } finally {
+    await app.close();
+  }
+});
+
+test('allowlist requires a tenant admin', async () => {
+  const app = await startTestServer();
+  try {
+    const none = await app.request('POST', '/tenants/acme/allowlist', { body: { domain: 'v.example' } });
+    assert.equal(none.status, 401);
+    const viewer = await app.request('POST', '/tenants/acme/allowlist', { token: 'tok-acme-viewer', body: { domain: 'v.example' } });
+    assert.equal(viewer.status, 403);
+    const other = await app.request('POST', '/tenants/acme/allowlist', { token: 'tok-globex-admin', body: { domain: 'v.example' } });
+    assert.equal(other.status, 403);
+  } finally {
+    await app.close();
+  }
+});
