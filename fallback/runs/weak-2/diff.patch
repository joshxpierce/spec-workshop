 import assert from 'node:assert/strict';
 import { createStore } from '../src/store.js';
 import { evaluate, validateMessage } from '../src/verdict.js';
@@ -49,3 +49,42 @@ test('validateMessage rejects bad input', () => {
   assert.ok(validateMessage(msg({ spf: 'maybe' }), store).length);
   assert.ok(validateMessage(msg({ attachments: 'a.zip' }), store).length);
 });
+
+describe('allowlist', () => {
+  const allowStore = createStore({
+    allowlist: { acme: ['vendorcorp.example', 'known-bad.example'], globex: [] },
+  });
+  const zip = [{ filename: 'invoice.zip' }];
+
+  test('allowlisted sender with SPF pass skips quarantine', () => {
+    const result = evaluate(msg({ sender: 'Billing@VendorCorp.Example', attachments: zip }), allowStore);
+    assert.deepEqual(pick(result), { verdict: 'ALLOW', reason: 'ALLOWLIST' });
+  });
+
+  test('allowlist does not apply without SPF pass', () => {
+    for (const spf of [undefined, 'none', 'softfail']) {
+      const result = evaluate(msg({ sender: 'b@vendorcorp.example', spf, attachments: zip }), allowStore);
+      assert.deepEqual(pick(result), { verdict: 'QUARANTINE', reason: 'ATTACHMENT_TYPE' }, `spf=${spf}`);
+    }
+  });
+
+  test('allowlist does not override SPF failure', () => {
+    const result = evaluate(msg({ sender: 'b@vendorcorp.example', spf: 'fail' }), allowStore);
+    assert.deepEqual(pick(result), { verdict: 'BLOCK', reason: 'SPF_FAIL' });
+  });
+
+  test('blocklist wins over allowlist', () => {
+    const result = evaluate(msg({ sender: 'x@known-bad.example' }), allowStore);
+    assert.deepEqual(pick(result), { verdict: 'BLOCK', reason: 'BLOCKLIST' });
+  });
+
+  test('allowlist matches the exact domain only', () => {
+    const result = evaluate(msg({ sender: 'b@evil.vendorcorp.example', attachments: zip }), allowStore);
+    assert.equal(result.verdict, 'QUARANTINE');
+  });
+
+  test('allowlist is tenant-scoped', () => {
+    const result = evaluate(msg({ tenantId: 'globex', sender: 'b@vendorcorp.example', attachments: zip }), allowStore);
+    assert.equal(result.verdict, 'QUARANTINE');
+  });
+});
