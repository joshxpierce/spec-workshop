diff --git a/tests/allowlist.test.js b/tests/allowlist.test.js
new file mode 100644
index 0000000..df6011e
--- /dev/null
+++ b/tests/allowlist.test.js
@@ -0,0 +1,169 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { startTestServer } from './helpers.js';
+import { REASON_LABELS } from '../src/reporting/daily-summary.js';
+import { Reason } from '../src/models.js';
+
+const ACME_ADMIN = 'tok-acme-admin';
+const GLOBEX_ADMIN = 'tok-globex-admin';
+const ZIP = [{ filename: 'invoice.zip' }];
+
+async function withApp(fn) {
+  const app = await startTestServer();
+  try {
+    await fn(app);
+  } finally {
+    await app.close();
+  }
+}
+
+async function allow(app, domain, token = ACME_ADMIN, tenant = 'acme') {
+  return app.request('POST', `/tenants/${tenant}/allowlist`, { token, body: { domain } });
+}
+
+async function verdict(app, body) {
+  const res = await app.request('POST', '/verdict', { body: { tenantId: 'acme', spf: 'pass', ...body } });
+  assert.equal(res.status, 200);
+  return res.body;
+}
+
+test('ALLOWLIST reason and label are published', () => {
+  assert.equal(Reason.ALLOWLIST, 'ALLOWLIST');
+  assert.equal(REASON_LABELS.ALLOWLIST, 'Delivered: tenant allowlist');
+});
+
+// AC1
+test('allowlisted domain, same tenant: ALLOW / ALLOWLIST, overriding quarantine', async () => {
+  await withApp(async (app) => {
+    assert.equal((await allow(app, 'vendorcorp.com')).status, 201);
+    const v = await verdict(app, { sender: '"Billing" <billing@VendorCorp.com>', attachments: ZIP });
+    assert.deepEqual(v, { verdict: 'ALLOW', reason: 'ALLOWLIST' });
+  });
+});
+
+test('allowlist hit logs allowlist_hit with tenant and sender domain only', async () => {
+  await withApp(async (app) => {
+    await allow(app, 'vendorcorp.com');
+    await verdict(app, { sender: 'billing@vendorcorp.com', subject: 'Invoice 4471', attachments: ZIP });
+    const hit = app.logs.find((l) => l.event === 'allowlist_hit');
+    assert.ok(hit, 'allowlist_hit event expected');
+    assert.deepEqual(Object.keys(hit).sort(), ['event', 'senderDomain', 'tenantId', 'ts']);
+    assert.equal(hit.tenantId, 'acme');
+    assert.equal(hit.senderDomain, 'vendorcorp.com');
+    const all = JSON.stringify(app.logs);
+    assert.ok(!all.includes('billing@'), 'full address must never be logged');
+    assert.ok(!all.includes('Invoice 4471'), 'subject must never be logged');
+    assert.ok(!all.includes('invoice.zip'), 'attachment names must never be logged');
+  });
+});
+
+test('no allowlist_hit log when the allowlist does not match', async () => {
+  await withApp(async (app) => {
+    await allow(app, 'vendorcorp.com');
+    await verdict(app, { sender: 'x@other.example' });
+    assert.ok(!app.logs.some((l) => l.event === 'allowlist_hit'));
+  });
+});
+
+// AC2 (must-not: lookalikes, subdomains, display name)
+test('lookalike, subdomain, and display-name senders are not allowlisted', async () => {
+  await withApp(async (app) => {
+    await allow(app, 'vendorcorp.com');
+    const senders = [
+      'billing@vendor-corp.com',
+      'billing@evilvendorcorp.com',
+      'billing@vendorcorp.com.evil.example',
+      'billing@mail.vendorcorp.com',
+      '"billing@vendorcorp.com" <billing@evil.example>',
+      'vendorcorp.com <billing@evil.example>',
+    ];
+    for (const sender of senders) {
+      const v = await verdict(app, { sender, attachments: ZIP });
+      assert.deepEqual(v, { verdict: 'QUARANTINE', reason: 'ATTACHMENT_TYPE' }, sender);
+    }
+  });
+});
+
+// AC3 (must-not: other tenants)
+test("tenant A's allowlist entry does not apply to tenant B", async () => {
+  await withApp(async (app) => {
+    await allow(app, 'vendorcorp.com');
+    const v = await verdict(app, { tenantId: 'globex', sender: 'billing@vendorcorp.com', attachments: ZIP });
+    assert.deepEqual(v, { verdict: 'QUARANTINE', reason: 'ATTACHMENT_TYPE' });
+  });
+});
+
+test("tenant B's admin gets 403 on tenant A's allowlist, and no audit row is written", async () => {
+  await withApp(async (app) => {
+    const get = await app.request('GET', '/tenants/acme/allowlist', { token: GLOBEX_ADMIN });
+    assert.equal(get.status, 403);
+    const post = await allow(app, 'vendorcorp.com', GLOBEX_ADMIN);
+    assert.equal(post.status, 403);
+    const del = await app.request('DELETE', '/tenants/acme/allowlist/vendorcorp.com', { token: GLOBEX_ADMIN });
+    assert.equal(del.status, 403);
+    assert.deepEqual(app.store.listAllowlist('acme'), []);
+    assert.equal(app.store.listAudit('acme').length, 0);
+  });
+});
+
+test('allowlist endpoints reject unauthenticated callers and viewers', async () => {
+  await withApp(async (app) => {
+    const anon = await app.request('POST', '/tenants/acme/allowlist', { body: { domain: 'vendorcorp.com' } });
+    assert.equal(anon.status, 401);
+    assert.equal((await allow(app, 'vendorcorp.com', 'tok-acme-viewer')).status, 403);
+    assert.equal((await app.request('GET', '/tenants/acme/allowlist', { token: 'tok-acme-viewer' })).status, 403);
+    assert.deepEqual(app.store.listAllowlist('acme'), []);
+    assert.equal(app.store.listAudit('acme').length, 0);
+  });
+});
+
+// AC4 (must-not: allowlist overriding BLOCK)
+test('blocklisted sender still BLOCKs even if allowlisted', async () => {
+  await withApp(async (app) => {
+    await allow(app, 'known-bad.example');
+    const v = await verdict(app, { sender: 'x@known-bad.example' });
+    assert.deepEqual(v, { verdict: 'BLOCK', reason: 'BLOCKLIST' });
+  });
+});
+
+test('SPF-fail sender still BLOCKs even if allowlisted', async () => {
+  await withApp(async (app) => {
+    await allow(app, 'vendorcorp.com');
+    const v = await verdict(app, { sender: 'billing@vendorcorp.com', spf: 'fail' });
+    assert.deepEqual(v, { verdict: 'BLOCK', reason: 'SPF_FAIL' });
+  });
+});
+
+// AC5
+test('allowlist add and remove each write exactly one audit row; failures write none', async () => {
+  await withApp(async (app) => {
+    const add = await allow(app, 'VendorCorp.COM');
+    assert.equal(add.status, 201);
+    assert.deepEqual(add.body, { domain: 'vendorcorp.com' });
+
+    assert.equal((await allow(app, 'vendorcorp.com')).status, 409);
+    assert.equal((await allow(app, '*.vendorcorp.com')).status, 400);
+    assert.equal((await allow(app, 'not a domain')).status, 400);
+
+    const list = await app.request('GET', '/tenants/acme/allowlist', { token: ACME_ADMIN });
+    assert.deepEqual(list, { status: 200, body: { domains: ['vendorcorp.com'] } });
+
+    const del = await app.request('DELETE', '/tenants/acme/allowlist/vendorcorp.com', { token: ACME_ADMIN });
+    assert.equal(del.status, 204);
+    const missing = await app.request('DELETE', '/tenants/acme/allowlist/vendorcorp.com', { token: ACME_ADMIN });
+    assert.equal(missing.status, 404);
+
+    const audit = await app.request('GET', '/tenants/acme/audit', { token: ACME_ADMIN });
+    assert.deepEqual(
+      audit.body.entries.map((r) => [r.action, r.actor, r.tenantId, r.domain]),
+      [
+        ['allowlist.add', 'alice@acme.example', 'acme', 'vendorcorp.com'],
+        ['allowlist.remove', 'alice@acme.example', 'acme', 'vendorcorp.com'],
+      ],
+    );
+    assert.ok(audit.body.entries.every((r) => !Number.isNaN(Date.parse(r.at))));
+
+    const after = await verdict(app, { sender: 'billing@vendorcorp.com', attachments: ZIP });
+    assert.deepEqual(after, { verdict: 'QUARANTINE', reason: 'ATTACHMENT_TYPE' });
+  });
+});
