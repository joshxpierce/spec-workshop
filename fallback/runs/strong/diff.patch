diff --git a/tests/allowlist.test.js b/tests/allowlist.test.js
new file mode 100644
index 0000000..0d12953
--- /dev/null
+++ b/tests/allowlist.test.js
@@ -0,0 +1,176 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { startTestServer } from './helpers.js';
+import { createStore } from '../src/store.js';
+import { evaluate } from '../src/verdict.js';
+import { REASON_LABELS } from '../src/reporting/daily-summary.js';
+
+const ACME_ADMIN = 'tok-acme-admin';
+const GLOBEX_ADMIN = 'tok-globex-admin';
+const pick = ({ verdict, reason }) => ({ verdict, reason });
+const storeWith = (allowlist) => createStore({ allowlist });
+const msg = (overrides) => ({
+  tenantId: 'acme',
+  sender: 'billing@vendorcorp.com',
+  spf: 'pass',
+  attachments: [{ filename: 'invoice.zip' }],
+  ...overrides,
+});
+
+// Criterion 1
+test('AC1: allowlisted domain for the same tenant returns ALLOW / ALLOWLIST', () => {
+  const store = storeWith({ acme: ['vendorcorp.com'] });
+  assert.deepEqual(pick(evaluate(msg(), store)), { verdict: 'ALLOW', reason: 'ALLOWLIST' });
+  assert.deepEqual(pick(evaluate(msg({ sender: '"Billing" <Billing@VendorCorp.COM>' }), store)), {
+    verdict: 'ALLOW',
+    reason: 'ALLOWLIST',
+  });
+});
+
+test('AC1: allowlist is added via API, used by /verdict, and logs allowlist_hit with tenant and domain only', async () => {
+  const app = await startTestServer();
+  try {
+    const add = await app.request('POST', '/tenants/acme/allowlist', { token: ACME_ADMIN, body: { domain: ' VendorCorp.com. ' } });
+    assert.equal(add.status, 201);
+    assert.deepEqual(add.body, { domain: 'vendorcorp.com' });
+
+    const list = await app.request('GET', '/tenants/acme/allowlist', { token: ACME_ADMIN });
+    assert.equal(list.status, 200);
+    assert.deepEqual(list.body, { domains: ['vendorcorp.com'] });
+
+    const res = await app.request('POST', '/verdict', {
+      body: { ...msg(), sender: '"Vendor Billing" <billing@vendorcorp.com>', subject: 'Invoice 42' },
+    });
+    assert.deepEqual(res.body, { verdict: 'ALLOW', reason: 'ALLOWLIST' });
+
+    const hits = app.logs.filter((l) => l.event === 'allowlist_hit');
+    assert.equal(hits.length, 1);
+    const { ts, event, ...fields } = hits[0];
+    assert.deepEqual(fields, { tenantId: 'acme', senderDomain: 'vendorcorp.com' });
+    const all = JSON.stringify(app.logs);
+    for (const secret of ['Invoice 42', 'billing@', 'invoice.zip', 'Vendor Billing']) {
+      assert.ok(!all.includes(secret), `${secret} must never be logged`);
+    }
+  } finally {
+    await app.close();
+  }
+});
+
+test('AC1: POST rejects invalid domains and wildcards with 400, duplicates with 409', async () => {
+  const app = await startTestServer();
+  try {
+    for (const domain of ['*.vendorcorp.com', '*', 'not a domain', 'billing@vendorcorp.com', 'localhost', '', undefined]) {
+      const res = await app.request('POST', '/tenants/acme/allowlist', { token: ACME_ADMIN, body: { domain } });
+      assert.equal(res.status, 400, `expected 400 for ${domain}`);
+    }
+    assert.equal((await app.request('POST', '/tenants/acme/allowlist', { token: ACME_ADMIN, body: { domain: 'vendorcorp.com' } })).status, 201);
+    assert.equal((await app.request('POST', '/tenants/acme/allowlist', { token: ACME_ADMIN, body: { domain: 'VENDORCORP.com' } })).status, 409);
+    assert.equal((await app.request('DELETE', '/tenants/acme/allowlist/vendorcorp.com', { token: ACME_ADMIN })).status, 204);
+    assert.equal((await app.request('DELETE', '/tenants/acme/allowlist/vendorcorp.com', { token: ACME_ADMIN })).status, 404);
+  } finally {
+    await app.close();
+  }
+});
+
+test('AC1: ALLOWLIST reason has its reporting label', () => {
+  assert.equal(REASON_LABELS.ALLOWLIST, 'Delivered: tenant allowlist');
+});
+
+// Criterion 2
+test('AC2: lookalike domains, subdomains, and display-name-only matches are not allowlisted', () => {
+  const store = storeWith({ acme: ['vendorcorp.com'] });
+  const senders = [
+    'billing@vendor-corp.com',
+    'billing@evilvendorcorp.com',
+    'billing@vendorcorp.com.evil.example',
+    'billing@mail.vendorcorp.com',
+    '"billing@vendorcorp.com" <billing@evil.example>',
+    'vendorcorp.com <billing@evil.example>',
+  ];
+  for (const sender of senders) {
+    assert.deepEqual(pick(evaluate(msg({ sender }), store)), { verdict: 'QUARANTINE', reason: 'ATTACHMENT_TYPE' }, sender);
+  }
+});
+
+// Criterion 3
+test('AC3: allowlist in tenant A does not allow mail to tenant B', () => {
+  const store = storeWith({ acme: ['vendorcorp.com'] });
+  assert.deepEqual(pick(evaluate(msg({ tenantId: 'globex' }), store)), { verdict: 'QUARANTINE', reason: 'ATTACHMENT_TYPE' });
+});
+
+test("AC3: tenant B's admin cannot read or change tenant A's allowlist (403)", async () => {
+  const app = await startTestServer();
+  try {
+    await app.request('POST', '/tenants/acme/allowlist', { token: ACME_ADMIN, body: { domain: 'vendorcorp.com' } });
+    const read = await app.request('GET', '/tenants/acme/allowlist', { token: GLOBEX_ADMIN });
+    const add = await app.request('POST', '/tenants/acme/allowlist', { token: GLOBEX_ADMIN, body: { domain: 'x.example' } });
+    const del = await app.request('DELETE', '/tenants/acme/allowlist/vendorcorp.com', { token: GLOBEX_ADMIN });
+    assert.deepEqual([read.status, add.status, del.status], [403, 403, 403]);
+    const viewer = await app.request('POST', '/tenants/acme/allowlist', { token: 'tok-acme-viewer', body: { domain: 'x.example' } });
+    assert.equal(viewer.status, 403);
+    const anon = await app.request('GET', '/tenants/acme/allowlist');
+    assert.equal(anon.status, 401);
+
+    const list = await app.request('GET', '/tenants/acme/allowlist', { token: ACME_ADMIN });
+    assert.deepEqual(list.body, { domains: ['vendorcorp.com'] });
+    const globex = await app.request('GET', '/tenants/globex/allowlist', { token: GLOBEX_ADMIN });
+    assert.deepEqual(globex.body, { domains: [] });
+  } finally {
+    await app.close();
+  }
+});
+
+// Criterion 4
+test('AC4: blocklist and SPF fail still BLOCK an allowlisted sender', () => {
+  const store = createStore({
+    blocklist: { acme: ['vendorcorp.com'] },
+    allowlist: { acme: ['vendorcorp.com', 'partner.example'] },
+  });
+  assert.deepEqual(pick(evaluate(msg(), store)), { verdict: 'BLOCK', reason: 'BLOCKLIST' });
+  assert.deepEqual(pick(evaluate(msg({ sender: 'ops@partner.example', spf: 'fail' }), store)), {
+    verdict: 'BLOCK',
+    reason: 'SPF_FAIL',
+  });
+});
+
+// Criterion 5
+test('AC5: each successful add/remove writes exactly one audit row; failures write none', async () => {
+  const app = await startTestServer();
+  try {
+    const before = Date.now();
+    await app.request('POST', '/tenants/acme/allowlist', { token: ACME_ADMIN, body: { domain: 'VendorCorp.com' } });
+    // Failures: duplicate, invalid, wildcard, unknown delete, wrong tenant, viewer, anonymous.
+    await app.request('POST', '/tenants/acme/allowlist', { token: ACME_ADMIN, body: { domain: 'vendorcorp.com' } });
+    await app.request('POST', '/tenants/acme/allowlist', { token: ACME_ADMIN, body: { domain: 'nope' } });
+    await app.request('POST', '/tenants/acme/allowlist', { token: ACME_ADMIN, body: { domain: '*.vendorcorp.com' } });
+    await app.request('DELETE', '/tenants/acme/allowlist/other.example', { token: ACME_ADMIN });
+    await app.request('POST', '/tenants/acme/allowlist', { token: GLOBEX_ADMIN, body: { domain: 'x.example' } });
+    await app.request('DELETE', '/tenants/acme/allowlist/vendorcorp.com', { token: 'tok-acme-viewer' });
+    await app.request('POST', '/tenants/acme/allowlist', { body: { domain: 'x.example' } });
+    await app.request('DELETE', '/tenants/acme/allowlist/vendorcorp.com', { token: ACME_ADMIN });
+
+    const acme = await app.request('GET', '/tenants/acme/audit', { token: ACME_ADMIN });
+    const rows = acme.body.entries.filter((r) => r.action.startsWith('allowlist.'));
+    assert.deepEqual(
+      rows.map((r) => [r.action, r.actor, r.tenantId, r.domain]),
+      [
+        ['allowlist.add', 'alice@acme.example', 'acme', 'vendorcorp.com'],
+        ['allowlist.remove', 'alice@acme.example', 'acme', 'vendorcorp.com'],
+      ],
+    );
+    assert.ok(rows.every((r) => Date.parse(r.at) >= before - 1000 && Date.parse(r.at) <= Date.now()));
+    const globex = await app.request('GET', '/tenants/globex/audit', { token: GLOBEX_ADMIN });
+    assert.deepEqual(globex.body.entries, []);
+  } finally {
+    await app.close();
+  }
+});
+
+// Criterion 6 is verified by `npm run bench`; this checks the lookup works at that size.
+test('AC6: 1,000 allowlist entries still match exactly', () => {
+  const domains = Array.from({ length: 999 }, (_, i) => `vendor-${i}.example`).concat('vendorcorp.com');
+  const store = storeWith({ acme: domains });
+  assert.equal(store.listAllowlist('acme').length, 1000);
+  assert.equal(evaluate(msg(), store).reason, 'ALLOWLIST');
+  assert.equal(evaluate(msg({ sender: 'a@vendor-1000.example' }), store).reason, 'ATTACHMENT_TYPE');
+});
