diff --git a/tests/api.test.js b/tests/api.test.js
index 79523a4..a68c3e6 100644
--- a/tests/api.test.js
+++ b/tests/api.test.js
@@ -92,3 +92,53 @@ test('blocklist add and remove each write one audit row', async () => {
     await app.close();
   }
 });
+
+test('allowlist add, list, and remove each write one audit row', async () => {
+  const app = await startTestServer();
+  try {
+    const add = await app.request('POST', '/tenants/acme/allowlist', { token: ADMIN, body: { domain: 'Vendor.Example' } });
+    assert.equal(add.status, 201);
+    assert.deepEqual(add.body, { domain: 'vendor.example' });
+    const dup = await app.request('POST', '/tenants/acme/allowlist', { token: ADMIN, body: { domain: 'vendor.example' } });
+    assert.equal(dup.status, 409);
+    const bad = await app.request('POST', '/tenants/acme/allowlist', { token: ADMIN, body: { domain: '*.example' } });
+    assert.equal(bad.status, 400);
+    const list = await app.request('GET', '/tenants/acme/allowlist', { token: ADMIN });
+    assert.deepEqual(list.body, { domains: ['vendor.example'] });
+
+    const verdict = await app.request('POST', '/verdict', {
+      body: { tenantId: 'acme', sender: 'billing@vendor.example', spf: 'pass', attachments: [{ filename: 'q3.zip' }] },
+    });
+    assert.deepEqual(verdict.body, { verdict: 'ALLOW', reason: 'ALLOWLIST' });
+
+    const del = await app.request('DELETE', '/tenants/acme/allowlist/vendor.example', { token: ADMIN });
+    assert.equal(del.status, 204);
+    const missing = await app.request('DELETE', '/tenants/acme/allowlist/vendor.example', { token: ADMIN });
+    assert.equal(missing.status, 404);
+
+    const audit = await app.request('GET', '/tenants/acme/audit', { token: ADMIN });
+    const rows = audit.body.entries.filter((r) => r.domain === 'vendor.example');
+    assert.deepEqual(
+      rows.map((r) => [r.action, r.actor, r.tenantId]),
+      [
+        ['allowlist.add', 'alice@acme.example', 'acme'],
+        ['allowlist.remove', 'alice@acme.example', 'acme'],
+      ],
+    );
+  } finally {
+    await app.close();
+  }
+});
+
+test('allowlist changes require a tenant admin', async () => {
+  const app = await startTestServer();
+  try {
+    const body = { domain: 'vendor.example' };
+    assert.equal((await app.request('POST', '/tenants/acme/allowlist', { body })).status, 401);
+    assert.equal((await app.request('POST', '/tenants/acme/allowlist', { token: 'tok-acme-viewer', body })).status, 403);
+    assert.equal((await app.request('POST', '/tenants/acme/allowlist', { token: 'tok-globex-admin', body })).status, 403);
+    assert.equal((await app.request('GET', '/tenants/acme/constructor', { token: ADMIN })).status, 404);
+  } finally {
+    await app.close();
+  }
+});
