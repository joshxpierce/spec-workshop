diff --git a/tests/rules.test.js b/tests/rules.test.js
index 6ba11fe..740ec15 100644
--- a/tests/rules.test.js
+++ b/tests/rules.test.js
@@ -49,3 +49,39 @@ test('validateMessage rejects bad input', () => {
   assert.ok(validateMessage(msg({ spf: 'maybe' }), store).length);
   assert.ok(validateMessage(msg({ attachments: 'a.zip' }), store).length);
 });
+
+const vendorStore = () => createStore({ allowlist: { acme: ['vendor.example'], globex: [] } });
+const vendorZip = (overrides) =>
+  msg({ sender: 'billing@vendor.example', attachments: [{ filename: 'invoice.zip' }], ...overrides });
+
+test('allowlisted sender with SPF pass skips quarantine', () => {
+  assert.deepEqual(pick(evaluate(vendorZip(), vendorStore())), { verdict: 'ALLOW', reason: 'ALLOWLIST' });
+});
+
+test('allowlist matches the normalized sender domain', () => {
+  const result = evaluate(vendorZip({ sender: '"Billing" <billing@VENDOR.example.>' }), vendorStore());
+  assert.deepEqual(pick(result), { verdict: 'ALLOW', reason: 'ALLOWLIST' });
+});
+
+test('allowlist does not apply unless SPF passed', () => {
+  for (const spf of [undefined, 'none', 'softfail']) {
+    const result = evaluate(vendorZip({ spf }), vendorStore());
+    assert.deepEqual(pick(result), { verdict: 'QUARANTINE', reason: 'ATTACHMENT_TYPE' }, `spf=${spf}`);
+  }
+});
+
+test('allowlist does not override BLOCK rules', () => {
+  const s = createStore({
+    blocklist: { acme: ['vendor.example'] },
+    allowlist: { acme: ['vendor.example'] },
+  });
+  assert.deepEqual(pick(evaluate(vendorZip(), s)), { verdict: 'BLOCK', reason: 'BLOCKLIST' });
+  assert.deepEqual(pick(evaluate(vendorZip({ spf: 'fail' }), vendorStore())), { verdict: 'BLOCK', reason: 'SPF_FAIL' });
+});
+
+test('allowlist is tenant-scoped and exact-domain', () => {
+  const s = vendorStore();
+  assert.equal(evaluate(vendorZip({ tenantId: 'globex' }), s).verdict, 'QUARANTINE');
+  assert.equal(evaluate(vendorZip({ sender: 'x@evil.vendor.example' }), s).verdict, 'QUARANTINE');
+  assert.equal(evaluate(vendorZip({ sender: 'x@vendor.example.evil' }), s).verdict, 'QUARANTINE');
+});
